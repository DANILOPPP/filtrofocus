#!/usr/bin/env sh
set -e
# Download gradle-wrapper.jar if missing
WRAPPER_JAR="gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p gradle/wrapper
  echo "Downloading gradle-wrapper.jar..."
  curl -sL -o "$WRAPPER_JAR" https://github.com/gradle/gradle/raw/master/gradle/wrapper/gradle-wrapper.jar
  # fallback url
  if [ ! -f "$WRAPPER_JAR" ]; then
    wget -q -O "$WRAPPER_JAR" https://services.gradle.org/distributions/gradle-8.4-bin.zip || true
  fi
fi
# Use system gradle if wrapper jar still missing
if [ -f "$WRAPPER_JAR" ]; then
  exec java -jar "$WRAPPER_JAR" "$@"
else
  exec gradle "$@"
fi
